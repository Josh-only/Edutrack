# EduTrack Frontend Environment Configuration Example
# Copy this file to .env.local to configure your local development environment.
# Note: Real credentials and secrets must NEVER be committed to version control.

# Base URL for API requests (default: /api)
# In development, the Vite dev server proxies /api to the backend.
# In production with a reverse proxy, keep /api or specify the full API origin.
VITE_API_BASE_URL=/api

# Target backend server URL or port for Vite dev proxy (default: http://localhost:3000)
VITE_BACKEND_URL=http://localhost:3000
